# 复制为 .env 后按需修改。默认值仅面向不暴露 MySQL 端口的本机部署。
MYSQL_PASSWORD=asharelens_local_2026
MYSQL_ROOT_PASSWORD=asharelens_root_local_2026
ASHARELENS_PORT=8000

# 数据源按顺序整批回退。默认 BaoStock 免费、免注册。
ASHARELENS_PROVIDERS=baostock
# 这里只是功能示例股票池，不构成投资建议。
ASHARELENS_SYMBOLS=sh.600000,sz.000001,sz.000858

ASHARELENS_STRATEGY=moving_average
ASHARELENS_STRATEGY_PARAMS={"fast_period":20,"slow_period":60,"confirm_days":3}
ASHARELENS_ACCOUNT_NAME=AShareLens 默认研究组合
ASHARELENS_LOOKBACK_DAYS=550
ASHARELENS_MIN_COVERAGE=0.98
ASHARELENS_INITIAL_CASH=1000000
ASHARELENS_TOP_N=3
ASHARELENS_MAX_WEIGHT=0.3
ASHARELENS_EXECUTION_MODEL={"slippage_bps":10,"commission_rate":0.0003,"minimum_commission":5,"transfer_fee_rate":0.00001,"stamp_duty_rate":0.0005,"board_lot":100,"tick_size":0.01}

# 周一至周五 18:00（北京时间）运行；交易所休市且所有源均无数据时安全跳过。
ASHARELENS_SCHEDULE_NAME=AShareLens 每日选股
ASHARELENS_SCHEDULE_TIME=18:00
ASHARELENS_SCHEDULE_TIMEZONE=Asia/Shanghai
ASHARELENS_SCHEDULE_WEEKDAYS=0,1,2,3,4

# 零配置默认写入 notification Runner 日志。
ASHARELENS_NOTIFIERS=console
# 需要通用 Webhook 时改为 console,webhook，并填写无内嵌凭据的 HTTPS URL。
ASHARELENS_WEBHOOK_URL=

# 可选：把 tushare 加入 ASHARELENS_PROVIDERS 后再填写。
TUSHARE_TOKEN=
